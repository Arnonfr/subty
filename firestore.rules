rules_version = '2';
service cloud.firestore {
  function isOperator() {
    return request.auth != null
      && request.auth.token.email in [
        'arnon7700@gmail.com',
        'frielabsdev@gmail.com'
      ];
  }

  function hasValidEventShape() {
    return request.resource.data.keys().hasOnly([
      'event', 'event_key', 'platform', 'client_ts', 'server_ts',
      'schema_version', 'install_id', 'params'
    ])
      && request.resource.data.params is map
      && request.resource.data.params.keys().hasOnly([
        'search_query', 'mode', 'has_season_episode', 'languages_count',
        'type', 'query_length', 'file_id', 'language_code', 'model',
        'engine', 'source_lang', 'target_lang', 'chars', 'entries', 'stars'
      ]);
  }
  match /databases/{database}/documents {
    // Live events coming from app clients
    match /live_events/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['event', 'event_key', 'platform', 'client_ts'])
                    && request.resource.data.platform == 'android'
                    && request.resource.data.event is string
                    && request.resource.data.event.size() > 0
                    && request.resource.data.event.size() < 80
                    && hasValidEventShape();
      allow read: if isOperator();
      allow update, delete: if false;
    }

    // Aggregated live metrics doc
    match /live_metrics/{docId} {
      allow read: if isOperator();
      allow create, update: if false;
      allow delete: if false;
    }

    // Ops toggles controlled by live dashboard
    match /ops_controls/{docId} {
      allow read: if isOperator();
      allow create, update: if isOperator();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
